-settled","Promise.all":"promise-all","Promise.race":"promise-race","Promise.any":"promise-any","import.meta":"import-meta","T[K]":"t-k",".d.ts Files":"d-ts-files","@types Packages":"types-packages","@ts-expect-error":"ts-expect-error","@ts-ignore":"ts-ignore","tsx and ts-node":"tsx-and-ts-node","ESM/CJS Interoperability":"esm-cjs-interoperability","yield*":"yield-star"}
    for old,new in special.items(): value=value.replace(old,new)
    value=re.sub(r"([a-z0-9])([A-Z])",r"\1-\2",value)
    return re.sub(r"[^A-Za-z0-9]+","-",value).strip("-").lower() or "topic"

def q(value): return json.dumps(value,ensure_ascii=False)
def write(path,content):
    path.parent.mkdir(parents=True,exist_ok=True)
    path.write_text(content,encoding="utf-8")

def definition(topic,category):
    exact={
      "Type Inference":"Type inference lets the checker derive a useful type from declarations, expressions, contextual expectations, and control flow.",
      "Structural Typing":"Structural typing compares members and call signatures rather than requiring matching declaration names.",
      "Assignability":"Assignability is TypeScript's practical relation for deciding whether a source value may be used at a target type.",
      "Widening":"Widening replaces an exact literal type with a broader mutable type when the value may later change.",
      "Narrowing":"Narrowing uses runtime checks and control flow to reduce a union to the cases still possible.",
      "Type Erasure":"Type erasure means most TypeScript-only syntax is removed before JavaScript executes.",
      "Compilation Pipeline":"The compiler parses source, binds symbols, checks types, reports diagnostics, and optionally emits JavaScript or declarations.",
      "Module Resolution":"Module resolution maps an import specifier to runtime files and declarations according to the selected environment.",
      "Runtime Validation":"Runtime validation checks actual values and converts valid input into a trusted domain shape.",
      "What satisfies Does":"The `satisfies` operator checks compatibility without replacing the expression's useful inferred type.",
    }
    return exact.get(topic,f"{topic} is part of {category.lower()}: {DESCRIPTIONS[category]}.")

