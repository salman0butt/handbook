sting": "testing which programs should compile and which should be rejected", "Testing TypeScript Applications": "keeping runtime tests strongly typed without unsafe casts", "ESLint and Code Quality": "using type-aware lint rules to catch risky behavior beyond compiler diagnostics", "Migration from JavaScript": "introducing TypeScript incrementally without stopping feature delivery", "Performance": "measuring and reducing checker, editor, declaration, and build costs", "Security": "keeping static types from becoming false trust at runtime security boundaries", "Architecture": "placing types at clear ownership and dependency boundaries in large systems", "Production Engineering": "operating TypeScript safely through CI, builds, monitoring, upgrades, and rollback", "Common TypeScript Mistakes": "recognizing patterns that weaken safety or make types harder to maintain", "Projects": "integrating multiple TypeScript skills into deliverable software", "Exercises": "building fluency through increasingly realistic type and production problems", "Interview Preparation": "explaining TypeScript clearly, debugging unfamiliar types, and making architecture trade-offs", "Reference and Audits": "quick lookup material, official sources, compatibility notes, and completeness evidence"}')
DIAGRAMS = json.loads('{"Compilation Pipeline": "flowchart LR\\n  SOURCE[\\"TypeScript source\\"] --> PARSE[\\"Parse\\"]\\n  PARSE --> BIND[\\"Bind symbols\\"]\\n  BIND --> CHECK[\\"Type check\\"]\\n  CHECK --> DIAGNOSTICS[\\"Diagnostics\\"]\\n  CHECK --> EMIT[\\"Optional emit\\"]\\n  EMIT --> RUNTIME[\\"JavaScript runtime\\"]\\n  CHECK --> ERASE[\\"Type-only syntax erased\\"]", "Static Types vs Runtime Values": "flowchart LR\\n  INPUT[\\"Runtime value\\"] --> JS[\\"JavaScript execution\\"]\\n  TYPES[\\"Static types\\"] --> CHECKER[\\"TypeScript checker\\"]\\n  CHECKER --> DIAGNOSTICS[\\"Diagnostics\\"]\\n  CHECKER --> ERASE[\\"Types erased\\"]\\n  ERASE --> JS", "Type Inference": "flowchart LR\\n  DECL[\\"Declaration\\"] --> CONTEXT[\\"Contextual expectation\\"]\\n  CONTEXT --> INFER[\\"Infer candidate type\\"]\\n  FLOW[\\"Control flow\\"] --> INFER\\n  INFER --> TYPE[\\"Useful static type\\"]", "Control Flow Analysis": "flowchart TD\\n  UNION[\\"string | number | null\\"] --> CHECK{\\"Runtime check\\"}\\n  CHECK -->|\\"typeof string\\"| STRING[\\"string\\"]\\n  CHECK -->|\\"typeof number\\"| NUMBER[\\"number\\"]\\n  CHECK -->|\\"null\\"| NULL[\\"null\\"]", "Assignability": "flowchart LR\\n  SOURCE[\\"Source type\\"] --> COMPARE{\\"Required target members satisfied?\\"}\\n  COMPARE -->|\\"Yes\\"| OK[\\"Assignable\\"]\\n  COMPARE -->|\\"No\\"| ERROR[\\"Diagnostic\\"]", "Structural Typing": "flowchart LR\\n  VALUE[\\"Value shape\\"] --> MEMBERS[\\"Compare members\\"]\\n  TARGET[\\"Target contract\\"] --> MEMBERS\\n  MEMBERS --> RESULT[\\"Compatible by structure\\"]", "Generic Constraints": "flowchart LR\\n  ARG[\\"Concrete type argument\\"] --> CONSTRAINT[\\"Constraint: minimum capability\\"]\\n  CONSTRAINT --> BODY[\\"Generic implementation\\"]\\n  BODY --> PRESERVE[\\"Specific type preserved\\"]", "Conditional Type Syntax": "flowchart TD\\n  INPUT[\\"Input type T\\"] --> TEST{\\"T assignable to U?\\"}\\n  TEST -->|\\"Yes\\"| TRUE[\\"True branch\\"]\\n  TEST -->|\\"No\\"| FALSE[\\"False branch\\"]", "Mapped Type Syntax": "flowchart LR\\n  KEYS[\\"keyof T\\"] --> MAP[\\"Map each key K\\"]\\n  MAP --> MODIFY[\\"Change modifiers or value type\\"]\\n  MODIFY --> RESULT[\\"New object type\\"]", "Module Resolution": "flowchart LR\\n  IMPORT[\\"Import specifier\\"] --> MODE[\\"moduleResolution mode\\"]\\n  MODE --> PACKAGE[\\"package.json exports/types\\"]\\n  MODE --> FILES[\\"File extension candidates\\"]\\n  PACKAGE --> RESULT[\\"Resolved module + declarations\\"]\\n  FILES --> RESULT", "Project References": "flowchart LR\\n  DOMAIN[\\"domain project\\"] --> API[\\"api project\\"]\\n  API --> APP[\\"application project\\"]\\n  ROOT[\\"solution tsconfig\\"] --> DOMAIN\\n  ROOT --> API\\n  ROOT --> APP", "Declaration Emit": "flowchart LR\\n  SOURCE[\\"Public TypeScript source\\"] --> CHECK[\\"Type check\\"]\\n  CHECK --> DTS[\\".d.ts declarations\\"]\\n  CHECK --> JS[\\"JavaScript output\\"]\\n  DTS --> CONSUMER[\\"Consumer checker\\"]\\n  JS --> RUNTIME[\\"Consumer runtime\\"]", "Typed API Clients": "flowchart LR\\n  REQUEST[\\"Typed request\\"] --> TRANSPORT[\\"HTTP transport\\"]\\n  TRANSPORT --> UNKNOWN[\\"Unknown response\\"]\\n  UNKNOWN --> VALIDATE[\\"Runtime validation\\"]\\n  VALIDATE --> RESULT[\\"Typed result\\"]", "Runtime Validation": "flowchart LR\\n  EXTERNAL[\\"External data\\"] --> UNKNOWN[\\"unknown\\"]\\n  UNKNOWN --> SCHEMA[\\"Runtime schema\\"]\\n  SCHEMA -->|\\"valid\\"| DOMAIN[\\"Trusted domain value\\"]\\n  SCHEMA -->|\\"invalid\\"| ERROR[\\"Validation error\\"]", "Migration Strategy": "flowchart LR\\n  JS[\\"JavaScript codebase\\"] --> BOUNDARY[\\"Type external boundaries\\"]\\n  BOUNDARY --> FILES[\\"Convert files incrementally\\"]\\n  FILES --> STRICT[\\"Raise strictness\\"]\\n  STRICT --> CI[\\"Required type-check CI\\"]", "Publishing to npm": "flowchart LR\\n  SOURCE[\\"Library source\\"] --> BUILD[\\"Runtime builds\\"]\\n  SOURCE --> DTS[\\"Declaration build\\"]\\n  BUILD --> EXPORTS[\\"package exports\\"]\\n  DTS --> EXPORTS\\n  EXPORTS --> TEST[\\"Consumer fixtures\\"]\\n  TEST --> PUBLISH[\\"npm publish\\"]", "Domain Models": "flowchart LR\\n  DB[\\"Database row\\"] --> MAP1[\\"Mapper\\"]\\n  MAP1 --> DOMAIN[\\"Domain model\\"]\\n  DOMAIN --> MAP2[\\"Presenter\\"]\\n  MAP2 --> DTO[\\"Public DTO\\"]", "CI Type Checking": "flowchart LR\\n  COMMIT[\\"Commit\\"] --> INSTALL[\\"Install\\"]\\n  INSTALL --> TYPES[\\"tsc --noEmit\\"]\\n  TYPES --> TEST[\\"Runtime tests\\"]\\n  TEST --> BUILD[\\"Production build\\"]\\n  BUILD --> DEPLOY[\\"Deploy\\"]"}')
CORE_INTRO = '---\ntitle: TypeScript Developer Handbook\ndescription: A TypeScript 7.0.2 learning system from JavaScript foundations to staff-level architecture, library authoring, and production engineering.\nslug: /typescript/intro\n---\n\n# TypeScript Developer Handbook\n\nThis handbook teaches TypeScript as an engineering system layered on JavaScript. It begins with runtime fundamentals and static-type mental models, then progresses through application development, advanced type transformations, framework integration, library authoring, architecture, performance, security, production operations, projects, and interviews.\n\n> **Compatibility baseline checked August 1, 2026:** TypeScript 7.0.2, Node.js 24 LTS for handbook CI, strict checking, explicit runtime-specific module settings, and current React, Vue, Zod, ESLint, Vitest, Jest, Vite, and npm documentation.\n\n```mermaid\nflowchart TD\n  JS["JavaScript developer"] --> BEGINNER["TypeScript beginner"]\n  BEGINNER --> APP["Type-safe application developer"]\n  APP --> ADVANCED["Advanced TypeScript developer"]\n  ADVANCED --> LIBRARY["Library and framework author"]\n  LIBRARY -->